{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Backend — FastAPI (uvicorn)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000,
      "cwd": "crm_subvenciones/backend"
    },
    {
      "name": "Frontend — React (Vite)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173,
      "cwd": "crm_subvenciones/frontend"
    },
    {
      "name": "Frontend — Standalone (Python)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5173"],
      "port": 5173,
      "cwd": "crm_subvenciones/frontend"
    }
  ]
}
