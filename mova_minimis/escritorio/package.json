{
  "name": "mova-minimis",
  "productName": "MOVAMinimis",
  "version": "1.1.3",
  "description": "MOVA Minimis: saldo de ayudas de minimis por cliente con los datos de la BDNS",
  "author": "MOVA IA",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^31.7.6",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "es.movaia.minimis",
    "productName": "MOVAMinimis",
    "copyright": "Copyright 2026 MOVA IA",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "arranque.js",
      "icono.ico"
    ],
    "extraResources": [
      {
        "from": "servidor",
        "to": "servidor"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icono.ico",
      "artifactName": "MOVAMinimis-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MOVA Minimis",
      "installerIcon": "icono.ico",
      "uninstallerIcon": "icono.ico",
      "installerHeaderIcon": "icono.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}
