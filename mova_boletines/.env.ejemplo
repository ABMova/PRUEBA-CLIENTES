# MOVA Boletines Oficiales - variables de entorno (copiar a .env)
# Todas son opcionales: lo que no se defina aqui se configura desde la pantalla Ajustes.

# Puerto del servidor web interno
MOVA_PUERTO=8770

# Direccion de escucha. 127.0.0.1 = solo este equipo; 0.0.0.0 = accesible en la red interna
MOVA_HOST=127.0.0.1

# Carpeta de datos. Por defecto: DATOS/ junto al ejecutable o al codigo
# MOVA_DATOS=D:\datos\mova_boletines

# Abrir el navegador al arrancar (1 en escritorio, 0 en servidor)
MOVA_ABRIR_NAVEGADOR=1

# URL publica con la que se construyen los enlaces "Descartar" del correo.
# En servidor con Nginx delante: https://boletines.miempresa.local
MOVA_URL_PUBLICA=http://127.0.0.1:8770

# Clave de API de Anthropic. Recomendado: dejarla vacia y guardarla cifrada desde Ajustes.
# ANTHROPIC_API_KEY=

# Nivel de registro: DEBUG, INFO, WARNING, ERROR
MOVA_LOG_NIVEL=INFO
